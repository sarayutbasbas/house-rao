# Vercel production: Neon pooled connection string (normally injected by integration)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Direct connection for migrations (normally injected by integration)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# From public Vercel Blob store (normally injected by integration)
BLOB_READ_WRITE_TOKEN=
AUTH_URL=https://house-rao.basnana.com
AUTH_TRUST_HOST=true
STORAGE_DRIVER=blob
